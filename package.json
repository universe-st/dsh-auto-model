{
  "name": "dsh-auto-model",
  "version": "0.1.0",
  "description": "Virtual models for DeepSeek Harness that route every request to a real provider/model through ordered, user-defined switching rules.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm-router",
    "model-switching",
    "fallback"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/universe-st/dsh-auto-model.git"
  },
  "homepage": "https://github.com/universe-st/dsh-auto-model#readme",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "zod": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
